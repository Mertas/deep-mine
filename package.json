{
  "name": "deep-mine",
  "version": "1.0.0",
  "description": "Deep Mine — idle auto-clicker where DQN learns to play Minesweeper",
  "private": true,
  "scripts": {
    "build": "node build.mjs",
    "build:client": "node build.mjs client",
    "build:server": "node build.mjs server",
    "kill": "node kill-port.js",
    "dev": "npm run kill && concurrently \"npm run dev:client\" \"npm run dev:server\"",
    "dev:client": "node build.mjs client --watch",
    "dev:server": "nodemon --watch server/src --ext ts --exec \"node build.mjs server && node dist/server/index.js\"",
    "prestart": "npm run kill",
    "start": "node dist/server/index.js"
  },
  "dependencies": {
    "@tensorflow/tfjs": "^4.22.0",
    "better-sqlite3": "^11.7.0",
    "express": "^4.21.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/express": "^5.0.0",
    "@types/ws": "^8.5.13",
    "concurrently": "^9.1.0",
    "esbuild": "^0.24.0",
    "nodemon": "^3.1.7",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
